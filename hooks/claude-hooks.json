{
  "description": "Add mechanical AI attribution to Claude Code git and GitHub creation commands.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-env=CLAUDE_PLUGIN_ROOT,CLAUDE_ASSISTED_BY_MODEL --allow-read \"${CLAUDE_PLUGIN_ROOT}/bin/claude-pre-tool-use.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
