{
  "description": "Add mechanical AI attribution to Codex git and GitHub creation commands.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-env=PLUGIN_ROOT,CODEX_ASSISTED_BY_MODEL \"$PLUGIN_ROOT/bin/codex-pre-tool-use.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
